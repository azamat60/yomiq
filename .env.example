# Ключ OpenAI. БЕЗ префикса VITE_ — иначе он попадёт в клиентский бандл.
OPENAI_API_KEY=sk-...

# Необязательно: модель для анализа фото и текста.
# gpt-5.6-terra — баланс точности и цены, gpt-5.6-luna — заметно дешевле.
OPENAI_MODEL=gpt-5.6-terra
OPENAI_TRANSCRIBE_MODEL=gpt-transcribe

# Необязательно, но нужно перед публикацией: без кода любой сможет
# жечь ваш ключ через /api/analyze. Код вводится один раз в профиле.
APP_ACCESS_CODE=

# Лимит запросов с одного IP в минуту.
RATE_LIMIT_PER_MINUTE=20
